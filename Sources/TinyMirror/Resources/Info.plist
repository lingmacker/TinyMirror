<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>TinyMirror</string>
	<key>CFBundleDisplayName</key>
	<string>TinyMirror</string>
	<key>CFBundleIdentifier</key>
	<string>com.lingmacker.TinyMirror</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>TinyMirror</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Menu bar app: no Dock icon, no main window at launch. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Required on macOS 15+: advertise and receive AirPlay on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>TinyMirror advertises this Mac as an AirPlay screen mirroring target and connects to your iPhone over Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>__COPYRIGHT__</string>
</dict>
</plist>
